{
    "name": "bizcarder",
    "private": true,
    "description": "Bizcarder CRM — monorepo tooling",
    "scripts": {
        "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "frontend/src/**/*.{js,jsx}": [
            "prettier --write"
        ],
        "frontend/src/*.{js,jsx}": [
            "./frontend/node_modules/.bin/eslint --config frontend/.eslintrc.cjs --fix --max-warnings 0"
        ],
        "frontend/src/!(__tests__)/**/*.{js,jsx}": [
            "./frontend/node_modules/.bin/eslint --config frontend/.eslintrc.cjs --fix --max-warnings 0"
        ],
        "backend/**/*.js": [
            "./backend/node_modules/.bin/eslint --config backend/.eslintrc.cjs --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.10.1"
    }
}
