{
    "name": "crm-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "sync:locales": "node scripts/sync-locales.mjs",
        "build": "npm run sync:locales && vite build",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
