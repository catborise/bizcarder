        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "axios": "^1.21.1",
        "dexie": "^4.4.7",
        "framer-motion": "^14.14.0",
        "i18next": "^27.2.6",
        "i18next-http-backend": "^4.1.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.3",
        "react-icons": "^5.7.0",
        "react-router": "^8.5.2",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.4.26",
        "fake-indexeddb": "^6.2.8",
        "jsdom": "^31.0.1",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
